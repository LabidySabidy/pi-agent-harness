# Secrets
agent/auth.json
agent/extensions/telepi-handoff.ts

# Session data
agent/sessions/

# Binaries
agent/bin/

# TelePi package (externally owned)
TelePi/

# Test results
test-results/

# PowerShell scripts (not harness code)
*.ps1

# Rolling memory (generated) — the harness's own working files, not shipped
/PROGRESS.md
/PLAN.md
/TASKS.md
/PLAN.md.archive

# System data (generated)
.agent/

# Personal memory (not shipped)
agent/lesson-stats.json
agent/AGENTS.md
# NOTE: agent/LESSONS.md IS shipped. It was excluded as "personal memory", but the README
# cites it by ID ("Recorded as GL-028 in agent/LESSONS.md"), so excluding it made those
# references dangle. It holds no secrets, usernames, or absolute paths — reviewed before
# shipping.
# NOTE: weekly-report/ IS shipped — its source is absorbed into this repo so a fresh
# clone gets the cost model. It has its own .gitignore (node_modules, .secrets.json,
# reports/, history.json, run logs, launchers) and carries no personal data.

# Generated state / local secrets
agent/models-store.json
agent/web-push.json
agent/whisper-vtt.json
agent/learning-demo/

# Session index written by pi-web's session-list-scanner.ts. Regenerated whenever pi-web runs, and a
# RUNTIME LOG in the sense of LESSONS.md GL-019: ~1 MB of session metadata carrying the OS username
# (1,131 hits) and home paths (71 "/Users/" + 1,006 ".pi" hits) — nothing secret, but not something to
# publish. Found untracked and NOT ignored on 2026-09-30, one `git add -A` from a public repo, because
# a NEW tool started writing into this directory. Its siblings agent/lesson-stats.json and
# agent/web-push.json were already ignored; this one was simply missed.
#
# Delete the file freely — pi-web rebuilds it.
agent/pi-web-session-index.json

# Pi package install root (agent/npm/.gitignore already ignores everything but itself)
agent/npm/

# Web-fetch cache written by pi-web-access (regenerable, not harness code)
agent/web-search-cache/

# Not a Pi extension dir — holds local tool config only
/extensions/

# Local analysis artifacts
/pi-integration-analysis.md
/harness-cleanup-plan.md
